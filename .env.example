# Auth.js session encryption key. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# GitHub OAuth App (https://github.com/settings/developers -> New OAuth App)
#   Homepage URL:  http://localhost:3000
#   Callback URL:  http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Local-only fake login so you can test the paywall without an OAuth app.
# Ignored when NODE_ENV=production.
AUTH_DEV_LOGIN=0

# Used only by `npm run data`. A fine-grained token with NO extra permissions
# (public data only) is enough. Never expose this to the app runtime.
GITHUB_TOKEN=
